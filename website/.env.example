# انسخ هذا الملف إلى .env واملأ القيم من لوحة Supabase.
# لا ترفع .env إلى Git — القيم تُضبط في متغيّرات بيئة Vercel.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=

# بادئة VITE_ تعني أن القيمة تُحقن في حزمة المتصفح وتصبح مرئية للزوّار.
# لا تضع هنا إلا المفاتيح المخصّصة للنشر العلني (publishable/anon).
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
